#!/bin/sh

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx|ts|tsx)$')

[ -z "$STAGED_FILES" ] && exit 0

echo "Running linter on staged files..."

echo "$STAGED_FILES" | xargs ./node_modules/.bin/eslint --max-warnings 0

EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo "Linter found issues. Commit aborted."
  exit $EXIT_CODE
fi

exit 0
